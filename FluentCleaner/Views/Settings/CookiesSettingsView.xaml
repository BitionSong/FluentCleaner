<UserControl
    x:Class="FluentCleaner.Views.Settings.CookiesSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12" MinHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="AvailableLabel" FontSize="13" FontWeight="SemiBold" />
                <TextBox x:Name="AvailableSearch" Grid.Row="1"
                         FontSize="12"
                         TextChanged="Search_TextChanged" />
                <Border Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <ListView x:Name="AvailableList"
                              FontSize="12"
                              SelectionMode="Multiple"
                              IsMultiSelectCheckBoxEnabled="False"
                              DoubleTapped="Available_DoubleTapped"
                              RightTapped="CookieList_RightTapped">
                        <ListView.ContextFlyout>
                            <MenuFlyout Opening="AvailableMenu_Opening">
                                <MenuFlyoutItem x:Name="KeepMenuItem" Click="Keep_Click" />
                                <MenuFlyoutItem x:Name="DeleteMenuItem" Click="Delete_Click" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                    </ListView>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="KeepButton" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                        Click="Keep_Click" />
                <Button x:Name="RemoveButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                        Click="Remove_Click" />
            </StackPanel>

            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="KeptLabel" FontSize="13" FontWeight="SemiBold" />
                <TextBox x:Name="KeptSearch" Grid.Row="1"
                         FontSize="12"
                         TextChanged="Search_TextChanged" />
                <Border Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <ListView x:Name="KeptList"
                              FontSize="12"
                              SelectionMode="Multiple"
                              IsMultiSelectCheckBoxEnabled="False"
                              DoubleTapped="Kept_DoubleTapped"
                              RightTapped="CookieList_RightTapped">
                        <ListView.ContextFlyout>
                            <MenuFlyout Opening="KeptMenu_Opening">
                                <MenuFlyoutItem x:Name="RemoveMenuItem" Click="Remove_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="ImportMenuItem" Click="Import_Click" />
                                <MenuFlyoutItem x:Name="ExportMenuItem" Click="Export_Click" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                    </ListView>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton" Click="Refresh_Click" />
            <TextBlock x:Name="StatusText" Grid.Column="1"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
